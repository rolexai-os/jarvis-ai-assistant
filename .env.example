# AI provider: openai or ollama
JARVIS_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Voice options. Wake/clap detection are OFF until enabled in the GUI.
JARVIS_VOICE_ENABLED=true
JARVIS_SPEECH_RATE=175
JARVIS_WAKE_WORD=jarvis

# Clap detector sensitivity: increase if background noise triggers it, decrease if claps are missed.
JARVIS_CLAP_THRESHOLD=0.18
JARVIS_CLAP_COOLDOWN=1.2
